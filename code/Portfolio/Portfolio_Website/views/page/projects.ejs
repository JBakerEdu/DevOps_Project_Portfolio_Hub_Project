<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Project Hub</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">

  <nav class="navbar navbar-expand-lg navbar-dark bg-dark static-top">
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" href="/">Home</a>
      </li>
      <li class="nav-item active">
        <a class="nav-link" href="/projects">Projects</a>
      </li>
    </ul>
  </nav>

  <main class="flex-fill">
    <div class="container mt-4">
      <div class="row mb-4">
        <div class="col">
          <h1>My DevOps Project Manager</h1>
          <p>This minimal GitHub‑style manager lets you upload, download, and track your builds with ease. Perfect for showcasing CI/CD and DevOps workflows.</p>
        </div>
      </div>

      <div class="row mb-5">
        <div class="col-md-6">
          <h2>About This Project</h2>
          <p>Built with Node.js, Express, and EJS, and styled using Bootstrap 4, Project Hub offers:</p>
          <ul>
            <li>Quick downloads of the latest build</li>
            <li>Download history logging</li>
            <li>Optional server‑side execution</li>
          </ul>
		  
		  <h2>Download Latest Build Executable Program</h2>
          <p><strong><%= fileName %></strong></p>
          <a href="/api/download_project" class="btn btn-primary">Download Project Hub</a>
		  
        </div>
        <div class="col-md-6">
          <div id="wireframeCarousel" class="carousel slide" data-ride="carousel" data-interval="5000">
            <ol class="carousel-indicators">
              <li data-target="#wireframeCarousel" data-slide-to="0" class="active"></li>
              <li data-target="#wireframeCarousel" data-slide-to="1"></li>
              <li data-target="#wireframeCarousel" data-slide-to="2"></li>
            </ol>
            <div class="carousel-inner">
              <div class="carousel-item active">
                <img class="d-block w-100" src="/images/DevOpsHomePage.PNG" alt="Wireframe 1">
				<h5>Projects Hub's Home Page</h5>
              </div>
              <div class="carousel-item">
                <img class="d-block w-100" src="/images/DevOpsProjectAboutPage.PNG" alt="Wireframe 2">
				<h5>The Page All About Your Project</h5>
              </div>
              <div class="carousel-item">
                <img class="d-block w-100" src="/images/DevOpsAccountPage.PNG" alt="Wireframe 3">
				<h5>View Your Account and Add More Information</h5>
              </div>
            </div>
            <a class="carousel-control-prev" href="#wireframeCarousel" role="button" data-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#wireframeCarousel" role="button" data-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="sr-only">Next</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="mt-auto bg-dark text-light py-3">
    <div class="container text-center">
      &copy; 2025 Jacob Baker. All rights reserved.
    </div>
  </footer>

	<script src="/js/jquery.min.js"></script>
	<script src="/js/bootstrap.min.js"></script>
	<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.6/dist/umd/popper.min.js"></script>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/js/bootstrap.min.js"></script>

</body>
</html>
